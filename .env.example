# --- Local use (optional) ---
# A server-side Claude key for convenience when running on your own computer ONLY.
# It is ignored automatically when HOST=0.0.0.0 (public hosting); users there bring their own key.
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5
# PORT=3456

# --- Accounts / hosting (see DEPLOY.md) ---
# INVITE_CODE=choose-a-secret      # only people with this code can sign up
# REGISTRATION=closed              # nobody can sign up (existing users can still sign in)
# DB_FILE=/data/songexplain.db     # where the SQLite file lives (put it on a persistent disk)
# HOST=0.0.0.0                     # listen on all interfaces (hosting)
# TRUST_PROXY=1                    # behind Fly / Render / Cloudflare
# COOKIE_SECURE=1                  # mark the login cookie Secure (https only)
