# --- Local use (optional) ---
# A server-side Claude key for convenience when running on your own computer ONLY.
# It is ignored automatically when HOST=0.0.0.0 (public hosting); users there bring their own key.
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5
# PORT=3456

# --- Accounts / hosting (see DEPLOY.md) ---
# REGISTRATION=invite              # sign-up needs a ONE-TIME code (admins create them in Account → Invite codes)
# INVITE_CODE=choose-a-secret      # (not recommended) one shared code that works for everyone who knows it
# OPERATOR_NAME=Your Name              # shown in the Terms and Privacy Notice
# CONTACT_EMAIL=you@example.com        # privacy / copyright-takedown contact (REQUIRED before inviting people)
# HOSTING_NOTE=Fly.io (servers in Singapore)   # shown in the Privacy Notice
# MAX_USERS=50                         # hard cap on accounts (admins exempt); unset = no cap
# ADMIN_EMAILS=you@example.com       # moderators: can hide/restore shared feelings (comma-separated)
# REGISTRATION=closed              # nobody can sign up except ADMIN_EMAILS (existing users can still sign in)
# APP_SECRET=                      # REQUIRED when hosting: encrypts users' saved API keys. Generate: openssl rand -base64 48
# DB_FILE=/data/songexplain.db     # where the SQLite file lives (put it on a persistent disk)
# HOST=0.0.0.0                     # listen on all interfaces (hosting)
# TRUST_PROXY=1                    # behind Fly / Render / Cloudflare
# COOKIE_SECURE=1                  # mark the login cookie Secure (https only)

# --- Search ---
# SEARCH_RESULTS=54                # max songs returned per search (shown 9 per page); 9–100
